# STEMM Labs — Firebase Configuration
#
# Copy this file to `.env` and fill in your own Firebase project values.
# Do NOT commit `.env` — it's listed in .gitignore.
#
# How to get these values:
# 1. Go to https://console.firebase.google.com
# 2. Create a project → Add a Web app (</> icon)
# 3. Copy the firebaseConfig values into the fields below
# 4. Enable Anonymous Auth, Firestore (test mode), and Storage

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Maps (Android) — required for react-native-maps in APK/AAB builds.
# Create an API key at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps SDK for Android
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_api_key

# AdMob — optional. If not set, the app uses Google's test IDs.
# Create an AdMob account at https://admob.google.com, register your app,
# then create a Banner ad unit. Both values below are PUBLIC identifiers
# (they get embedded in the APK manifest and bundle), not secrets.
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
